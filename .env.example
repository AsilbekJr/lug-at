# =============================================================================
# LINGUISTMN Environment Variables
# Nusxa oling va nomini '.env' ga o'zgartirib kalitlaringizni kiriting:
# =============================================================================

# 1. Groq Cloud API (Whisper-large-v3 - Mutlaqo bepul STT)
# Olish uchun: https://console.groq.com/keys
VITE_GROQ_API_KEY=

# 2. Google Gemini API (Gemini 2.5 Flash - Tarjima, xotira va SRS mashqlari uchun)
# Olish uchun: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=

# 3. Supabase (Ixtiyoriy - ma'lumotlar bazasi va bulutli saqlash uchun)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
